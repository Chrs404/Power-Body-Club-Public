DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/DATABASE?schema=public"

PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:4200

JWT_SECRET=
JWT_EXPIRES_IN=7d

# Credenziali iniziali dell'istruttore, lette dal seed.
# Se non impostate, in sviluppo vengono usati valori predefiniti.
# In produzione il seed si rifiuta di partire senza TRAINER_PASSWORD.
TRAINER_USERNAME=istruttore
TRAINER_PASSWORD=

# Keep-alive (facoltativo, spento se non impostato).
# Vedi src/utils/keep-alive.ts per i rischi: Render considera questo
# traffico anomalo e lo elenca fra i motivi di sospensione.
# L'indirizzo DEVE essere quello pubblico, non localhost.
KEEP_ALIVE_URL=
# Fascia oraria, ora italiana. "7-22" = solo negli orari di apertura,
# circa 450 ore al mese sulle 750 incluse. Senza, attivo 24 ore su 24.
KEEP_ALIVE_HOURS=7-22
